{
  "name": "realestate-crm",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "serve:ssr:realestate-crm": "node dist/realestate-crm/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.7",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/signals": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "@primeuix/themes": "^3.1.1",
    "chart.js": "^4.6.1",
    "express": "^5.1.0",
    "ng2-charts": "^11.0.0",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  }
}
